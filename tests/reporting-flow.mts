import assert from 'node:assert/strict';
import fs from 'node:fs';
import type { Browser } from 'playwright';
import { open, clear, noWelcome } from './harness.mts';
export async function reportingFlowCheck(browser: Browser): Promise<string> {
 const dir='out/reporting-flow';fs.mkdirSync(dir,{recursive:true});
 const fixture=await browser.newPage({viewport:{width:430,height:873}});
 try{
  await fixture.route('**/__report_capture__',r=>r.fulfill({contentType:'text/html',body:'<!doctype html><html style="height:100%"><body style="margin:0;height:100%;background:rgb(200,200,210)"><div id="stage"><canvas width="430" height="873" style="position:fixed;inset:0;width:430px;height:873px"></canvas></div><div class="modal" style="position:fixed;left:60px;top:100px;width:200px;height:100px;background:rgb(240,20,180)">Interface</div></body></html>'}));
  await fixture.goto('http://localhost:8765/__report_capture__');
  const capture=await fixture.evaluate(async()=>{
   const url='/js/screencapture.js',m:typeof import('../js/screencapture.js')=await import(url),source=document.querySelector('canvas'),g=source.getContext('2d');g.fillStyle='rgb(20,180,80)';g.fillRect(0,0,source.width,source.height);
   const native=Object.getOwnPropertyDescriptor(HTMLImageElement.prototype,'src');
   // Simulate browsers omitting nested images inside a foreignObject.
   Object.defineProperty(HTMLImageElement.prototype,'src',{configurable:true,get:native.get,set(this:HTMLImageElement,value:string){if(value.startsWith('data:image/svg+xml')){const comma=value.indexOf(','),xml=decodeURIComponent(value.slice(comma+1));if(xml.includes('foreignObject'))value=value.slice(0,comma+1)+encodeURIComponent(xml.replace(/<img\b[^>]*\/?>/g,''));}native.set.call(this,value);}});
   try{const full=await m.captureScreen(source),scene=await m.captureScreen(source,{sceneOnly:true});const read=async(value:string)=>{const i=new Image();i.src=value;await i.decode();const c=document.createElement('canvas');c.width=i.width;c.height=i.height;const x=c.getContext('2d');x.drawImage(i,0,0);return {world:[...x.getImageData(20,20,1,1).data],control:[...x.getImageData(80,140,1,1).data]};};return {full:await read(full),scene:await read(scene)};}finally{Object.defineProperty(HTMLImageElement.prototype,'src',native);}
  });
  const green=(p:number[])=>p[1]>140&&p[0]<80;
  assert.ok(green(capture.full.world),'full capture lost world when nested images were omitted');assert.ok(capture.full.control[0]>180&&capture.full.control[2]>100&&capture.full.control[1]<90,'capture lost interface');assert.ok(green(capture.scene.world)&&green(capture.scene.control),'scene capture retained interface');fs.writeFileSync(dir+'/capture.json',JSON.stringify(capture,null,2));
 }finally{await fixture.close();}
 let mode:'ok'|'hang'|'invalid'|'server-error'|'limit'='ok';const requests:string[]=[],release:(()=>void)[]=[];
 const P=await open(browser,{w:430,h:873,touch:true,route:async ctx=>{
  await ctx.route('**/content/custom.json*',r=>r.fulfill({json:{}}));await ctx.route('**/api/live**',r=>r.fulfill({json:{releases:{tester:{on:true,devices:['tester000001']}}}}));
  await ctx.route('**/api/tester**',async r=>{if(r.request().method()!=='POST')return r.fulfill({json:{ok:true,mine:[],open:[]}});const body=r.request().postDataJSON();requests.push(body.clientId||'other');if(mode==='hang'){await new Promise<void>(resolve=>release.push(resolve));await r.abort().catch(()=>{});return;}if(mode==='invalid')return r.fulfill({json:{ok:true}});if(mode==='server-error')return r.fulfill({status:503,json:{error:'fixture unavailable'}});if(mode==='limit')return r.fulfill({status:429,json:{error:'too many reports today'}});return r.fulfill({json:{ok:true,rid:'receipt-'+body.clientId,k:'fixture-problem'}});});
 },pre:()=>{localStorage.setItem('sv2_playerid','tester000001');localStorage.setItem('sv2_tester',JSON.stringify({at:1,b:'r87'}));localStorage.setItem('sv2_live',JSON.stringify({releases:{tester:{on:true,devices:['tester000001']}}}));}});
 try{
  await clear(P.page);await noWelcome(P.page);await P.page.waitForFunction(()=>!!window.__sv.tester);const layouts: { name: string; lang: string; sceneLit: boolean; card: {x:number;y:number;w:number;h:number}; send: {x:number;y:number;w:number;h:number}; close: {x:number;y:number;w:number;h:number}; bodyHeight:number; overflowX:boolean; minTargets:boolean; sendAccessible:boolean; lost?: {label:string;className:string}[] }[]=[];
  for(const [name,w,h,age] of [['small',320,640,'little'],['phone',430,873,'little'],['phone-short',430,517,'little'],['landscape',873,430,'little'],['tablet',820,1180,'little'],['computer',1280,800,'big']] as const){for(const lang of ['en','vi'] as const){
   await P.page.setViewportSize({width:w,height:h});await P.page.evaluate(async({age,lang})=>{window.__sv.heroes[0].profile.age=age;const s='/js/state.js',state:typeof import('../js/state.js')=await import(s);state.settings.lang=lang;const u='/js/tester.js',t:typeof import('../js/tester.js')=await import(u);await t.openPanel(0);},{age,lang});await P.page.locator('.reporting-form textarea').waitFor();await P.page.evaluate(()=>document.fonts.ready);await P.page.waitForTimeout(150);
   const layout=await P.page.locator('.reporting-form').evaluate((panel,little)=>{const r=(e:Element)=>{const b=e.getBoundingClientRect();return {x:b.x,y:b.y,w:b.width,h:b.height};},card=r(panel.querySelector('.card')),send=r(panel.querySelector('.tp-send')),close=r(panel.querySelector('.tp-head .x'));return {card,send,close,bodyHeight:panel.querySelector('.testing-report').clientHeight,overflowX:panel.scrollWidth>innerWidth+2,minTargets:[...panel.querySelectorAll('.testing-tabs button,.tp-retry,.tp-send,.tp-head .x,.tp-k')].every(b=>{const box=r(b);return box.w>=(little?64:44)&&box.h>=(little?64:44);}),sendAccessible:panel.querySelector('.tp-send').contains(document.elementFromPoint(send.x+send.w/2,send.y+send.h/2))};},age==='little');
   assert.ok(layout.minTargets&&layout.bodyHeight>40&&!layout.overflowX&&layout.sendAccessible,JSON.stringify({name,lang,layout}));assert.ok(layout.card.y>=0&&layout.card.y+layout.card.h<=h+1&&layout.close.y>=0&&layout.close.y+layout.close.h<=h,JSON.stringify({name,lang,layout}));const sceneLit=await P.page.locator('.tp-full').evaluate(async input=>{if(!(input instanceof HTMLInputElement))return false;input.checked=false;input.dispatchEvent(new Event('change'));const image=document.querySelector<HTMLImageElement>('.tp-shot');await image.decode();const c=document.createElement('canvas');c.width=image.naturalWidth;c.height=image.naturalHeight;const x=c.getContext('2d');x.drawImage(image,0,0);const pixels=x.getImageData(0,0,c.width,c.height).data;let lit=0,n=0;for(let k=0;k<pixels.length;k+=64){n++;if(Math.max(pixels[k],pixels[k+1],pixels[k+2])>15)lit++;}input.checked=true;input.dispatchEvent(new Event('change'));return n>0&&lit/n>.5;});
   assert.ok(sceneLit,'captured world frame is blank: '+name+' '+lang);
   if(lang==='en')await P.page.screenshot({path:`${dir}/${name}.png`});layouts.push({name,lang,sceneLit,...layout});
   if(name==='phone-short'&&lang==='vi'){await P.page.locator('.tp-picture-open').click();await P.page.locator('.tp-picture img').waitFor();await P.page.waitForTimeout(300);const picture=await P.page.locator('.tp-picture img').boundingBox();assert.ok(picture.width>w-100,'picture viewer is still a thumbnail');await P.page.screenshot({path:`${dir}/phone-picture.png`});await P.page.locator('.tp-picture .x').click();await P.page.locator('.tp-picture').waitFor({state:'detached'});}
   await P.page.locator('.reporting-form .tp-head .x').click();await P.page.locator('.reporting-form').waitFor({state:'detached'});
   const lost=await P.page.evaluate(async()=>{const u='/js/tester-detection.js',d:typeof import('../js/tester-detection.js')=await import(u),top=d.activeReportPanel(document);return [...document.querySelectorAll('.modal button,.hud button,.gl button,.dialog button')].filter(b=>d.unreachableControl(b,top)).map(b=>({label:(b.getAttribute('aria-label')||b.textContent||'').trim().slice(0,80),className:b.className}));});layouts[layouts.length-1].lost=lost;assert.deepEqual(lost,[],'offscreen HUD control: '+name+' '+lang);
  }}
  await P.page.setViewportSize({width:430,height:873});await P.page.evaluate(async()=>{const u='/js/tester.js',t:typeof import('../js/tester.js')=await import(u);await t.openPanel(0);});
  const keyboard=await P.page.evaluate(()=>{const vv=visualViewport;Object.defineProperty(vv,'height',{configurable:true,value:390});Object.defineProperty(vv,'offsetTop',{configurable:true,value:100});vv.dispatchEvent(new Event('resize'));const b=document.querySelector('.tp-send').getBoundingClientRect(),card=document.querySelector('.reporting-form .card').getBoundingClientRect(),good=card.top>=100&&card.bottom<=490&&b.bottom<=490;Reflect.deleteProperty(vv,'height');Reflect.deleteProperty(vv,'offsetTop');vv.dispatchEvent(new Event('resize'));return good;});assert.ok(keyboard,'keyboard covers report footer');
  await P.page.evaluate(()=>localStorage.setItem('sv2_tester_out',JSON.stringify([{id:'tester000001',b:'r87',kind:'broken',at:1,clientId:'report-flow-first',note:'Synthetic queued report'}])));mode='hang';await P.page.locator('.tp-retry').click();await P.page.waitForFunction(()=>document.querySelector<HTMLButtonElement>('.tp-retry').disabled);assert.match(await P.page.locator('.tp-delivery').innerText(),/Sending|Đang gửi/);
  await P.page.evaluate(async()=>{const u='/js/tester.js',t:typeof import('../js/tester.js')=await import(u);void t.retryReports();void t.retryReports();const q=JSON.parse(localStorage.getItem('sv2_tester_out'));q.push({id:'tester000001',b:'r87',kind:'broken',at:2,clientId:'report-flow-second'});localStorage.setItem('sv2_tester_out',JSON.stringify(q));});await P.page.waitForFunction(async()=>{const u='/js/tester.js',t:typeof import('../js/tester.js')=await import(u);return !t.reportingState().sending;},null,{timeout:30000});assert.equal(requests.filter(x=>x==='report-flow-first').length,1,'concurrent retries duplicated request');
  const retained=await P.page.evaluate(()=>JSON.parse(localStorage.getItem('sv2_tester_out')).map(r=>r.clientId));assert.ok(retained.includes('report-flow-first')&&retained.includes('report-flow-second'),'timeout lost report');
  await P.ctx.setOffline(true);await P.page.locator('.tp-retry').click();assert.match(await P.page.locator('.tp-delivery').innerText(),/saved|đã lưu/);await P.ctx.setOffline(false);
  // (owner, 1 Nov 2026 AEDT: "Retry always says it could not send, with internet") the day's limit is said as the reason and the report stays
  mode='limit';await P.page.locator('.tp-retry').click();await P.page.waitForFunction(()=>!document.querySelector<HTMLButtonElement>('.tp-retry').disabled);assert.match(await P.page.locator('.tp-delivery').innerText(),/today|hôm nay/,'the limit is said');assert.ok(await P.page.evaluate(()=>!!JSON.parse(localStorage.getItem('sv2_tester_out')).find(r=>r.clientId==='report-flow-first')),'limit removed report');
  for(const fail of ['invalid','server-error'] as const){mode=fail;await P.page.locator('.tp-retry').click();await P.page.waitForFunction(()=>!document.querySelector<HTMLButtonElement>('.tp-retry').disabled);assert.ok(await P.page.evaluate(()=>!!JSON.parse(localStorage.getItem('sv2_tester_out')).find(r=>r.clientId==='report-flow-first')),fail+' removed report');}
  mode='ok';await P.page.locator('.tp-retry').click();await P.page.waitForFunction(()=>JSON.parse(localStorage.getItem('sv2_tester_out')||'[]').length===0);assert.match(await P.page.locator('.tp-delivery').innerText(),/Nothing waiting|Không còn/);assert.ok(requests.includes('report-flow-second'),'report queued during sending lost');await P.page.locator('.reporting-form .tp-head .x').click();await P.page.locator('.reporting-form').waitFor({state:'detached'});await P.page.evaluate(()=>dispatchEvent(new Event('sv-report-queue')));fs.writeFileSync(dir+'/layouts.json',JSON.stringify(layouts,null,2));assert.deepEqual(P.errors,[]);
  return '12 EN/VI device layouts, 64px little controls, keyboard-visible footer, full picture viewer, world/interface capture, bounded/coalesced retry, offline/invalid/503 recovery and receipt-backed queue';
 }finally{release.forEach(f=>f());await P.ctx.close();}
}
