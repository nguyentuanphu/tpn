  "lines": [
    {
      "id": "61c75539-1167c3cc",
      "lang": "en",
      "text": "Listen for a friend calling. The sound rings and arrow show the way.",
      "area": "games",
      "part": false,
      "source": [
        "js/howto-data.ts"
      ]
    },
    {
      "id": "cad06358-127d5562",
      "lang": "vi",
      "text": "Nghe tiếng bạn gọi. Vòng âm thanh và mũi tên chỉ đường cho con.",
      "area": "games",
      "part": false,
      "source": [
        "js/howto-data.ts"
      ]
    },
    {
      "id": "90e6d4ce073df2c7",
      "lang": "en",
      "text": "Use the arrows to guide the blindfolded friend inside the circle.",
      "area": "games",
      "part": false,
      "source": [
        "js/howto-data.ts"
      ]
    },
    {
      "id": "ab862a1d4448fa92",
      "lang": "vi",
      "text": "Dùng mũi tên dẫn bạn bịt mắt đi trong vòng tròn.",
      "area": "games",
      "part": false,
      "source": [
        "js/howto-data.ts"
      ]
    },
    {
      "id": "d48eb7da-7b87cf08",
      "lang": "en",
      "text": "When your friend is close, tap Catch. Then that friend wears the blindfold.",
      "area": "games",
      "part": false,
      "source": [
        "js/howto-data.ts"
      ]
    },
    {
      "id": "0b282a21-22dc2f22",
      "lang": "vi",
      "text": "Khi đến gần bạn, chạm Bắt. Rồi bạn ấy làm người bịt mắt.",
      "area": "games",
      "part": false,
      "source": [
        "js/howto-data.ts"
      ]
    },
    {
      "id": "e07e0cd1-5283b76d",
      "lang": "en",
      "text": "For real: ask a grown-up to organise a gentle game in a clear, safe space. Everyone stays inside the circle.",
      "area": "games",
      "part": false,
      "source": [
        "js/howto-data.ts"
      ]
    },
    {
      "id": "ecee4965-2f6ad76b",
      "lang": "vi",
      "text": "Chơi thật: nhờ người lớn tổ chức trò chơi nhẹ nhàng ở chỗ trống, an toàn. Mọi người ở trong vòng tròn.",
      "area": "games",
      "part": false,
      "source": [
        "js/howto-data.ts"
      ]
    },
    {
      "id": "debf97d4-733a7c23",
      "lang": "en",
      "text": "Play Bịt mắt bắt dê! Guide the blindfolded friend. Listen, follow the call, then catch a friend nearby.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/goat.ts"
      ]
    },
    {
      "id": "2e6ec91741176d63",
      "lang": "vi",
      "text": "Cùng chơi Bịt mắt bắt dê! Dẫn bạn bịt mắt đi nào. Nghe tiếng gọi, đi theo, rồi bắt bạn ở gần nhé.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/goat.ts"
      ]
    },
    {
      "id": "706c0f41-2249d5de",
      "lang": "en",
      "text": "Your friend is close. Catch!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/goat.ts"
      ]
    },
    {
      "id": "fea49d75-7ee86574",
      "lang": "vi",
      "text": "Bạn ở gần rồi. Bắt nào!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/goat.ts"
      ]
    },
    {
      "id": "71bf6723-3ae670d1",
      "lang": "en",
      "text": "Caught! Now your friend wears the blindfold.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/goat.ts"
      ]
    },
    {
      "id": "aa1b68df-1faf794b",
      "lang": "vi",
      "text": "Bắt được rồi! Giờ đến lượt bạn bịt mắt.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/goat.ts"
      ]
    },
    {
      "id": "76fb212434c687be",
      "lang": "en",
      "text": "Not close enough yet. Follow the call!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/goat.ts"
      ]
    },
    {
      "id": "cbb7f9a368b158dd",
      "lang": "vi",
      "text": "Chưa đủ gần đâu. Đi theo tiếng gọi nhé!",
