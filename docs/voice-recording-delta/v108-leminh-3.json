   "text": "chuột",
   "area": "games",
   "part": false,
   "source": [
    "js/content/tiengviet2.ts"
   ]
  },
  {
   "id": "7b3fda76-5a37884b",
   "lang": "vi",
   "text": "Khách trả nhiều tiền hơn giá món hàng.",
   "area": "games",
   "part": false,
   "source": [
    "js/games/money3-meta.ts"
   ]
  },
  {
   "id": "7b72a7ff-66dfa168",
   "lang": "vi",
