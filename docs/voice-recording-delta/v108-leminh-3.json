   "area": "games",
   "part": false,
   "source": [
    "js/content/english.ts"
   ]
  },
  {
   "id": "7b1e5ccd-425c02df",
   "lang": "vi",
   "text": "Một phần đã có. Thêm mấy nữa thì thành số lớn?",
   "area": "games",
   "part": false,
   "source": [
    "js/games/maths3-meta.ts"
   ]
  },
