   "part": false,
   "source": [
    "js/games/science2.ts"
   ]
  },
  {
   "id": "1f5146653ec097e7",
   "lang": "vi",
   "text": "Pin cũ",
   "area": "core",
   "part": false,
   "source": [
    "js/games/science2.ts"
   ]
  },
  {
   "id": "c474a9b1-697db0d7",
   "lang": "vi",
   "text": "Pin không bao giờ bỏ vào thùng rác: mang tới điểm thu gom riêng để tránh gây cháy.",
   "area": "core",
   "part": false,
   "source": [
    "js/games/science2.ts"
   ]
  },
  {
   "id": "9aa9dd05059a6b46",
   "lang": "vi",
   "text": "Gói bim bim",
   "area": "core",
   "part": false,
   "source": [
    "js/games/science2.ts"
   ]
  },
  {
   "id": "654e7b1b2a42f50a",
   "lang": "vi",
   "text": "Gói bim bim là nhựa và giấy bạc dính liền nhau, nên bỏ vào rác còn lại.",
   "area": "core",
   "part": false,
   "source": [
    "js/games/science2.ts"
   ]
  },
  {
   "id": "3be3293b445bd01e",
   "lang": "vi",
   "text": "Gấu bông bị rách",
   "area": "core",
   "part": false,
   "source": [
    "js/games/science2.ts"
   ]
  },
  {
   "id": "71900114-fc672f6",
   "lang": "vi",
   "text": "Gấu bông rách quá không cho ai được thì bỏ vào rác còn lại. Nếu còn tốt, hãy tặng bạn nhé!",
   "area": "core",
   "part": false,
   "source": [
    "js/games/science2.ts"
   ]
  },
  {
   "id": "d0f1045d6584e744",
   "lang": "vi",
   "text": "Tái chế một chiếc lon tiết kiệm đủ điện để xem ti vi ba tiếng đồng hồ!",
   "area": "core",
   "part": false,
   "source": [
    "js/games/science2.ts"
   ]
  },
