// Four parent-facing destinations; existing sections are moved, never duplicated or removed.
export function simplifyNavigation(html){
const groups=[
 ['discover','Discover','Khám phá',[['discover','Welcome to the valley','Chào mừng đến thung lũng'],['pictures','Pictures & places','Hình ảnh và nơi chốn'],['world','Illustrated overview','Bảng giới thiệu']]],
 ['learn','Play & Learn','Chơi và học',[['games','Learning activities','Hoạt động học tập'],['art-guide','Colours and pictures','Màu sắc và tranh'],['folk','Vietnamese folk games','Trò chơi dân gian Việt Nam'],['stories','Vietnamese stories','Truyện Việt Nam']]],
 ['guides','Guides & Rewards','Hướng dẫn và quà',[['quest-guide','Full Quest Guide','Hướng dẫn nhiệm vụ đầy đủ'],['rewards','Prizes & badges','Quà thưởng và huy hiệu'],['festivals','Festival calendar & activities','Lịch lễ hội và hoạt động']]],
 ['family','For Parents','Dành cho cha mẹ',[['parents','Playing together','Cùng nhau chơi'],['parent-controls','Parent settings','Cài đặt phụ huynh'],['child-play-reports','Child play reports','Báo cáo chơi của bé'],['family-quiz','Your family questions','Câu hỏi của gia đình'],['faq','Parent questions','Điều cha mẹ muốn biết'],['help','Help & family settings','Trợ giúp và cài đặt gia đình']]]
];
const label=(en,vi)=>`data-en="${en.replaceAll('&','&amp;')}" data-vi="${vi.replaceAll('&','&amp;')}"`;
html=html.replace(/<nav class="quick-nav"[\s\S]*?<\/nav>/,`<nav class="quick-nav" aria-label="Main navigation">${groups.map(([id,en,vi])=>`<a href="#${id}" ${label(en,vi)}></a>`).join('')}</nav>`);
html=html.replace(/<nav class="drawer-links">[\s\S]*?<\/nav>/,`<nav class="drawer-links">${groups.map(([id,en,vi,links])=>`<details class="menu-group" data-menu-group="${id}"><summary ${label(en,vi)}></summary><a class="group-start" href="#${id}" ${label('Overview →','Giới thiệu →')}></a>${links.map(([target,a,b])=>`<a href="#${target}" ${label(a,b)}></a>`).join('')}</details>`).join('')}</nav>`);
html=html.replace('A compact header, with room for every section.','Four sections. All the details, when you need them.').replace('Thanh đầu gọn gàng, đủ chỗ cho mọi chuyên mục.','Bốn chuyên mục. Đầy đủ chi tiết khi gia đình cần.');
const pages=groups.slice(1).map(([id,en,vi,links])=>`<div class="container topic-page ${id}-page" data-topic="${id}" hidden><section class="topic-intro" id="${id}"><a class="quiet-link" href="#discover" ${label('← Discover the valley','← Khám phá thung lũng')}></a><h1 ${label(en,vi)}></h1><p ${label(id==='learn'?'Explore activities, Vietnamese folk games and stories. Open any card for the full explanation.':id==='guides'?'Choose a journey, see what to earn, or explore a festival. The complete guides stay one tap away.':'Practical ways to share play, add family questions and choose what suits your child.',id==='learn'?'Khám phá hoạt động, trò dân gian và truyện Việt. Mở từng thẻ để đọc giải thích đầy đủ.':id==='guides'?'Chọn hành trình, xem quà thưởng hoặc khám phá lễ hội. Hướng dẫn đầy đủ luôn ở ngay đây.':'Cách thiết thực để chơi cùng bé, thêm câu hỏi gia đình và chọn điều phù hợp với con.')}></p><nav class="topic-links" aria-label="Section navigation">${links.map(([target,a,b])=>`<a href="#${target}" ${label(a,b)}></a>`).join('')}</nav></section></div>`).join('');
html=html.replace('<!-- QUEST-PAGE -->',pages+'<!-- QUEST-PAGE -->');
const cards=`<section class="section start-here"><div class="section-kicker" ${label('START WITH WHAT MATTERS TO YOUR FAMILY','BẮT ĐẦU VỚI ĐIỀU GIA ĐÌNH QUAN TÂM')}></div><h2 ${label('A little guidance. A whole valley to discover.','Một chút dẫn lối. Cả thung lũng để khám phá.')}></h2><div class="journey-grid">${groups.slice(1).map(([id,en,vi])=>`<a class="journey-card" href="#${id}"><h3 ${label(en,vi)}></h3><p ${label(id==='learn'?'What children do, practise and discover in each activity.':id==='guides'?'Every quest, festival hunt, prize and badge explained.':'Family play, parent-created questions, settings and answers.',id==='learn'?'Bé làm gì, luyện tập và khám phá điều gì trong từng hoạt động.':id==='guides'?'Giải thích từng nhiệm vụ, săn đồ lễ hội, quà và huy hiệu.':'Chơi cùng gia đình, câu hỏi cha mẹ tự thêm, cài đặt và giải đáp.')}></p><span ${label('Explore →','Khám phá →')}></span></a>`).join('')}</div></section>`;
html=html.replace('<!-- PARENT-FULL-CONTENT -->',cards+'<!-- PARENT-FULL-CONTENT -->');
const setup=`const destinations={learn:['games','art-guide','folk','stories'],guides:['rewards','festival-overview'],family:['parents','parent-controls','family-quiz','faq','help']};for(const [page,ids]of Object.entries(destinations)){const parent=document.querySelector('.'+page+'-page');for(const id of ids){const node=document.getElementById(id);if(!node)throw Error('Missing retained section '+id);parent.append(node)}}const intro=document.querySelector('.parent-intro');if(intro)document.querySelector('.family-page').append(intro);
`;
html=html.replace("let lang='en'",setup+"let lang='en'");
const route=`function route(){let id;try{id=decodeURIComponent(location.hash.slice(1)||'discover')}catch{id='discover'}const target=document.getElementById(id)||document.getElementById('discover'),page=target.closest('.topic-page,.quest-page,.festival-page,.home-page')||document.querySelector('.home-page');document.querySelectorAll('.topic-page,.quest-page,.festival-page,.home-page').forEach(p=>p.hidden=p!==page);const guide=page.classList.contains('quest-page'),festival=page.classList.contains('festival-page'),category=guide||festival?'guides':page.dataset.topic||'discover';document.querySelectorAll('.quick-nav a').forEach(a=>a.getAttribute('href')==='#'+category?a.setAttribute('aria-current','page'):a.removeAttribute('aria-current'));document.querySelectorAll('.menu-group').forEach(g=>g.open=g.dataset.menuGroup===category);if(festival&&id.startsWith('festival-')){festivalFilter='all';applyFestivalFilter()}if(id.startsWith('quest-')&&search.value){search.value='';filterQuests()}if(target.matches('details'))target.open=true;target.scrollIntoView({behavior:'instant',block:'start'});if(location.hash){target.setAttribute('tabindex','-1');target.focus({preventScroll:true})}}`;
html=html.replace(/function route\(\)\{[^\n]+/,route);
html=html.replace('</style>',`
[hidden]{display:none!important}.topic-intro{padding:48px 0 24px;scroll-margin-top:90px}.topic-intro:focus{outline:none}.topic-intro h1{font-size:clamp(32px,4vw,52px);margin:24px 0 14px}.topic-intro p{max-width:720px;color:#69566e;line-height:1.7}.topic-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.topic-links a{display:flex;align-items:center;min-height:48px;padding:8px 18px;border:1px solid #ddc8e8;border-radius:24px;background:#fff8ed;color:#51375e;text-decoration:none}.journey-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.journey-card{display:block;padding:26px;border-radius:26px;border:2px solid #dfcfea;background:#fffaf0;text-decoration:none;color:#51375e;box-shadow:0 6px 0 #ede2f0}.journey-card h3{font-size:24px;margin:0 0 14px}.journey-card p{line-height:1.6;font-size:16px}.journey-card span{font-weight:bold}.menu-group{border-bottom:1px solid #e7d9ed;padding:10px 0}.menu-group summary{min-height:56px;align-content:center;cursor:pointer;font-size:22px;font-weight:bold;color:#51375e}.drawer-links .menu-group a{font-size:17px;min-height:48px;padding:10px 16px}.quick-nav a[aria-current=page]{background:#f0e3f7;border-radius:16px}.drawer-links{display:block}.topic-page .section{padding-top:35px}@media(max-width:700px){.journey-grid{grid-template-columns:1fr}.topic-intro{padding-top:30px}.topic-links a{min-height:56px}.menu-group summary{min-height:64px}.drawer-links .menu-group a{min-height:56px}.menu-group[open] a{display:flex;align-items:center;width:100%;margin:8px 0 0;line-height:1.25}}
</style>`);
return html;
}
