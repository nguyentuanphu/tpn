// Serve an isolated r88 source copy with _parent-capture.html (game CSS/fonts, no main startup script). See image manifest.
const path=require('path');const {createRequire}=require('module');const {chromium}=createRequire(path.resolve(__dirname,'../../tests/package.json'))('playwright');
(async()=>{const b=await chromium.launch({headless:true});try{for(const lang of ['en','vi']){const ctx=await b.newContext({viewport:{width:820,height:1180},deviceScaleFactor:1});const p=await ctx.newPage();p.setDefaultTimeout(15000);await p.route('**/api/**',r=>r.abort());await p.goto((process.env.SV_CAPTURE_URL||'http://127.0.0.1:8765/_parent-capture.html'),{waitUntil:'domcontentloaded'});await p.evaluate(async lang=>{const s=await import('/js/state.js');Object.assign(s.settings,{countPlayers:false,online:false,voice:false,music:false,sound:false,lang});const child=s.profiles[0]||s.addProfile();child.name=lang==='en'?'Example child':'Bé ví dụ';s.saveSettings();document.documentElement.lang=lang;(await import('/js/ui-settings.js')).openGrownups()},lang);await p.locator('.modal.grownups').waitFor();await p.evaluate(()=>document.querySelector('details[data-sec="players"]').open=true);await p.evaluate(()=>document.fonts.ready);await p.waitForFunction(()=>getComputedStyle(document.querySelector('.modal.grownups')).opacity==='1');await p.screenshot({clip:await p.locator('.modal.grownups .card').boundingBox(),path:path.join(__dirname,'assets/parent-controls/settings-'+lang+'.png')});console.log('Settings captured '+lang);await p.locator('.modal.grownups [data-rep]').click();console.log('Report requested '+lang);await p.waitForFunction(()=>getComputedStyle(document.querySelector('.modal.report')).opacity==='1');await p.screenshot({clip:await p.locator('.modal.report .card').boundingBox(),path:path.join(__dirname,'assets/parent-controls/report-'+lang+'.png')});console.log('Report captured '+lang);await ctx.close()}}finally{await b.close()}})().catch(e=>{console.error(e);process.exit(1)});
