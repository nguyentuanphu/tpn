// Owner requested an illustrative graph. All numbers below are invented, never loaded from saves.
import fs from 'node:fs';
const catalogue=JSON.parse(fs.readFileSync(new URL('./festival-snapshot.json',import.meta.url))).games;
export const sampleWeek=[{id:'mon',name:['Monday','Thứ Hai'],short:['Mon','T2'],minutes:12,rounds:2},{id:'tue',name:['Tuesday','Thứ Ba'],short:['Tue','T3'],minutes:18,rounds:3},{id:'wed',name:['Wednesday','Thứ Tư'],short:['Wed','T4'],minutes:0,rounds:0},{id:'thu',name:['Thursday','Thứ Năm'],short:['Thu','T5'],minutes:15,rounds:2},{id:'fri',name:['Friday','Thứ Sáu'],short:['Fri','T6'],minutes:22,rounds:4},{id:'sat',name:['Saturday','Thứ Bảy'],short:['Sat','T7'],minutes:10,rounds:1},{id:'sun',name:['Sunday','Chủ Nhật'],short:['Sun','CN'],minutes:16,rounds:3}];
export const sampleFavourites=[{id:'numbers',rounds:12},{id:'memory',rounds:9},{id:'colors',rounds:6}];
export function exampleReport({dual,esc}){
 const D=(tag,pair,cls='')=>dual(tag,cls,pair),sum=key=>sampleWeek.reduce((s,d)=>s+d[key],0);
 const detail=d=>[`${d.name[0]}: ${d.minutes} minutes of play · ${d.rounds} recorded game rounds.`,`${d.name[1]}: ${d.minutes} phút chơi · ${d.rounds} lượt trò đã ghi.`];
 const days=sampleWeek.map(d=>{const label=detail(d);return `<button type="button" class="example-day" data-demo-day="${d.id}" data-label-en="${esc(label[0])}" data-label-vi="${esc(label[1])}" aria-label="${esc(label.join(' / '))}" aria-pressed="${d.id==='sun'}"><span class="example-column"><b>${d.minutes}</b><span class="example-bar" aria-hidden="true" style="--sample-minutes:${d.minutes}"></span></span>${D('span',d.short,'example-day-name')}</button>`}).join('');
 const favourites=sampleFavourites.map(d=>{const game=catalogue.find(g=>g.id===d.id);if(!game)throw Error('Sample report names a missing game '+d.id);return `<li><div>${D('strong',game.name)}${D('span',[`${d.rounds} recorded rounds`,`${d.rounds} lượt đã ghi`])}</div><span class="example-fav-track" aria-hidden="true"><i style="width:${d.rounds/12*100}%"></i></span></li>`}).join('');
 return `<figure class="example-report" id="example-play-report" aria-describedby="example-report-disclaimer"><figcaption>${D('strong',['ILLUSTRATIVE EXAMPLE · MADE-UP DATA','VÍ DỤ MINH HỌA · SỐ LIỆU GIẢ ĐỊNH'],'example-label')}${D('h3',['A week in an example child’s valley','Một tuần của bé trong ví dụ'])}${D('p',['Here is how play activity could look after a child has played. Every number in this illustration is invented. The actual game screens are pictured below.','Đây là hình dung hoạt động sau khi bé đã chơi. Mọi số trong hình minh họa đều được tạo làm ví dụ. Màn hình trò chơi thật ở bên dưới.'])}</figcaption><div class="example-totals"><div>${D('span',['Example seven-day play time','Giờ chơi ví dụ trong bảy ngày'])}<strong data-example-minutes="${sum('minutes')}">${sum('minutes')} <small>${D('span',['min','phút'])}</small></strong></div><div>${D('span',['Example recorded game rounds','Số lượt trò ví dụ đã ghi'])}<strong data-example-rounds="${sum('rounds')}">${sum('rounds')}</strong></div></div>${D('h4',['Minutes of play each day','Số phút chơi mỗi ngày'])}${D('p',['Choose a day to see its example detail.','Chọn một ngày để xem chi tiết ví dụ.'],'example-chart-help')}${D('p',['On a small screen, swipe the chart sideways to see all seven days.','Trên màn hình nhỏ, vuốt biểu đồ sang ngang để xem đủ bảy ngày.'],'example-pan-hint')}<div class="example-chart-scroll" tabindex="0" aria-label="Illustrative seven-day play-time graph / Biểu đồ giờ chơi bảy ngày minh họa"><div class="example-plot">${days}</div></div>${D('p',detail(sampleWeek.at(-1)),'example-day-detail')}<div class="example-favourites">${D('h4',['Favourite activities · example saved history','Hoạt động yêu thích · lịch sử ví dụ'])}${D('p',['These example counts cover saved history, rather than only the seven days above. They describe recorded play, not lesson completion or ability.','Các lượt ví dụ này tính trong lịch sử đã lưu, không chỉ bảy ngày trên. Chúng mô tả lượt chơi, không phải số bài hoàn thành hay năng lực.'])}<ol>${favourites}</ol></div><p id="example-report-disclaimer" data-en="Invented demonstration only. It does not show your child’s data, assess learning or set a target for how much a child should play." data-vi="Chỉ là minh họa giả định. Không hiển thị dữ liệu của con bạn, không đánh giá học tập và không đặt mục tiêu bé phải chơi bao lâu."></p></figure>`;
}
export const exampleReportScript=`document.querySelectorAll('[data-demo-day]').forEach(button=>button.onclick=()=>{document.querySelectorAll('[data-demo-day]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));const out=document.querySelector('.example-day-detail');out.dataset.en=button.dataset.labelEn;out.dataset.vi=button.dataset.labelVi;out.textContent=out.dataset[lang]});`;
