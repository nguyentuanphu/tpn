const {chromium}=require('module').createRequire(require('path').resolve(__dirname,'../../tests/package.json'))('playwright');
const fs=require('fs'),assert=require('assert'),path=require('path');
const base=process.env.SV_PREVIEW_URL||'http://127.0.0.1:8765/docs/website-review-20261023/prototype.html',out=path.join(__dirname,'evidence');
async function menuGo(page,hash){await page.locator('[data-open-menu]').click();const link=page.locator('#menu-dialog a[href=\"'+hash+'\"]');const summary=link.locator('xpath=..').locator('summary');if(!await link.isVisible())await summary.click();await link.click()}
(async()=>{const browser=await chromium.launch({headless:true,args:['--disable-dev-shm-usage']});const results=[];
try{for(const [name,width,height]of [['phone',390,844],['tablet',820,1180],['desktop',1440,1000],['small-phone',320,740],['phone-landscape',844,390]]){const ctx=await browser.newContext({viewport:{width,height}}),page=await ctx.newPage(),errors=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(base,{waitUntil:'networkidle'});await page.evaluate(()=>document.fonts.ready);
const photos=await page.locator('.home-page .game-photo,.topic-page .game-photo').count();assert.equal(photos,17);assert.equal(await page.locator('.guide-item').count(),137);assert.equal(await page.locator('[data-static-art]').count(),2);assert.equal(await page.locator('#quest-familyquiz .quiz-setup li').count(),5);
assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
await page.locator('#pictures').scrollIntoViewIfNeeded();await page.screenshot({path:`${out}/photo-tour-${name}.png`});
await page.locator('.photo-open').first().click();assert(await page.locator('#image-dialog').evaluate(d=>d.open));assert(await page.locator('#large-image').evaluate(i=>i.complete&&i.naturalWidth>0));await page.keyboard.press('Escape');assert(await page.locator('.photo-open').first().evaluate(b=>document.activeElement===b));
await page.evaluate(()=>location.hash='#family-quiz');await page.waitForFunction(()=>!document.querySelector('.family-page').hidden);await page.locator('[data-quiz-answer=night]').click();assert(/Try the other/.test(await page.locator('#sample-quiz-result').innerText()));await page.locator('[data-quiz-answer=thanks]').click();assert(/Yes!/.test(await page.locator('#sample-quiz-result').innerText()));
await menuGo(page,'#quest-guide');await page.waitForFunction(()=>!document.querySelector('.quest-page').hidden);assert(await page.locator('.home-page').evaluate(d=>d.hidden));assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));await page.screenshot({path:`${out}/quest-guide-${name}-en.png`});
await page.locator('#quest-search').fill('puppy');assert.equal(await page.locator('.guide-item:not([hidden])').count(),1);await page.locator('.guide-item:not([hidden])>summary').click();assert(await page.locator('.guide-item:not([hidden])').evaluate(d=>d.open));
await page.locator('#language-button').click();assert(await page.locator('.guide-item:not([hidden])').evaluate(d=>d.open));await page.locator('#quest-search').fill('cun con');assert.equal(await page.locator('.guide-item:not([hidden])').count(),1);await page.locator('#clear-search').click();assert.equal(await page.locator('.guide-item:not([hidden])').count(),137);
await page.locator('.guide-nav a[href="#guide-lanterns"]').click();await page.waitForFunction(()=>location.hash==='#guide-lanterns');await page.locator('#quest-c2_find>summary').click();await page.locator('#quest-c2_find').scrollIntoViewIfNeeded();await page.screenshot({path:`${out}/quest-lanterns-${name}-vi.png`});assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
await page.locator('#quest-search').fill('ZZZnoSuchQuest');assert.equal(await page.locator('.guide-item:not([hidden])').count(),0);assert(/0/.test(await page.locator('#quest-results').innerText()));await page.locator('#clear-search').click();
await page.locator('[data-guide-back]').click();await page.waitForFunction(()=>!document.querySelector('.home-page').hidden);await page.evaluate(()=>location.hash='#family-quiz');await page.waitForFunction(()=>!document.querySelector('.family-page').hidden);await page.locator('#family-quiz').scrollIntoViewIfNeeded();await page.screenshot({path:`${out}/family-quiz-${name}-vi.png`});await page.evaluate(()=>location.hash='#pictures');await page.waitForFunction(()=>!document.querySelector('.home-page').hidden);await page.locator('.photo-open').first().click();assert(/Thung lũng/.test(await page.locator('#image-caption').innerText()));await page.locator('#close-image').click();
await page.locator('[data-mode-button=game]').click();await page.locator('#settings-button').click();await page.locator('.website-entry').click();await menuGo(page,'#quest-guide');await page.waitForFunction(()=>!document.querySelector('.quest-page').hidden);await page.locator('#close-site').click();assert(await page.locator('#settings-panel').evaluate(d=>d.classList.contains('open')));assert(await page.locator('.website-entry').evaluate(b=>document.activeElement===b));
await page.locator('[data-mode-button=website]').click();await page.emulateMedia({media:'print'});await page.evaluate(()=>dispatchEvent(new Event('beforeprint')));assert.equal(await page.locator('.quest-page .guide-item[open]').count(),137);assert.equal(await page.locator('.quest-page .guide-item:visible').count(),137);await page.evaluate(()=>dispatchEvent(new Event('afterprint')));await page.emulateMedia({media:'screen'});assert.deepEqual(errors,[]);results.push({name,width,height,photos,guideEntries:137,noOverflow:true,lightbox:true,focusReturn:true,ownMenu:true,searchEnglishVietnamese:true,noResults:true,languagePreservesDetails:true,floatingGuide:true,underlyingSettingsPreserved:true,familyQuizDemo:true,familyQuizSetup:true,printAllEntries:true,errors});await ctx.close();}
}finally{await browser.close()}
fs.writeFileSync(out+'/visual-guide-checks.json',JSON.stringify(results,null,2));console.log(JSON.stringify(results,null,2));})().catch(e=>{console.error(e);process.exit(1)});
