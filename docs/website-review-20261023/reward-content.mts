import fs from 'node:fs';
export const rewardData=JSON.parse(fs.readFileSync(new URL('./reward-snapshot.json',import.meta.url)));
const quests=JSON.parse(fs.readFileSync(new URL('./quest-snapshot.json',import.meta.url)));
export const rewardCards=[
 {id:'daily',icons:['🪙','🐔','⭐'],title:['A little adventure. A little treasure.','Phiêu lưu nhỏ. Kho báu nhỏ.'],complete:['Finish all three steps of today’s adventure.','Hoàn thành đủ ba bước phiêu lưu hôm nay.'],earn:['10 coins + the adventure’s sticker + one stamp. The sticker depends on which adventure the game chose.','10 xu + hình dán của phiêu lưu + một dấu. Hình dán tùy cuộc phiêu lưu trò chơi đã chọn.'],find:['Open the adventure card and your Sticker Book. Seven stamps fill a chest card.','Mở thẻ phiêu lưu và Sổ Hình Dán. Đủ bảy dấu làm đầy thẻ rương.'],link:'#guide-daily'},
 {id:'week',icons:['🧰','🐱','👑'],title:['Seven stamps. A special chest.','Bảy dấu. Một chiếc rương đặc biệt.'],complete:['Earn seven daily-adventure stamps. They do not have to be on consecutive days.','Nhận bảy dấu phiêu lưu hằng ngày. Không cần bảy ngày liên tiếp.'],earn:['A companion hat or a pet from the prize list below. You receive the next prize not already owned; once all are owned, the chest gives 50 coins.','Một mũ cho bạn đồng hành hoặc thú cưng trong danh sách dưới. Bé nhận quà tiếp theo chưa có; khi đã có đủ quà, rương tặng 50 xu.'],find:['The daily adventure’s week chest. Hats are for your companion; pets are for looking after.','Rương tuần của phiêu lưu hằng ngày. Mũ dành cho bạn đồng hành; thú cưng để bé chăm sóc.'],link:'#guide-daily'},
 {id:'lantern',icons:['🏮','🪙','🏠'],title:['A lantern to bring home.','Mang đèn lồng về nhà.'],complete:['Find and hang the lantern at the end of a lantern-story chapter.','Tìm và treo đèn ở cuối một chương truyện đèn lồng.'],earn:['Lotus Village: 30 coins. Hà Nội: 40. Sydney: 40. Each completed chapter also gives its lantern keepsake for your room.','Làng Sen: 30 xu. Hà Nội: 40. Sydney: 40. Mỗi chương hoàn thành còn tặng đèn lồng lưu niệm cho phòng của bé.'],find:['Look in your room’s decoration choices. Later chapters also teach your companion a new trick.','Xem lựa chọn trang trí phòng. Các chương sau còn dạy bạn đồng hành trò mới.'],link:'#guide-lanterns'},
 {id:'festival',icons:['🎖️','🏮','🏠'],title:['Your festival badge!','Huy hiệu lễ hội của bé!'],complete:['Find all five sparkling objects in an active festival hunt.','Tìm đủ năm món lấp lánh trong đợt săn đồ lễ hội đang diễn ra.'],earn:['That festival’s badge + a keepsake for your house. Seasonal availability follows the game calendar and family settings.','Huy hiệu của lễ hội đó + quà lưu niệm cho nhà. Nội dung theo mùa tùy lịch trò chơi và cài đặt gia đình.'],find:['Passport → Festival badges, and your house’s decorations.','Hộ chiếu → Huy hiệu lễ hội, cùng đồ trang trí nhà.'],link:'#guide-festivals'},
 {id:'stickers',icons:['🐃','🪷','🖼️'],title:['Fill a page. Frame your discoveries.','Dán đầy trang. Đóng khung khám phá.'],complete:['Collect every sticker on one Sticker Book page, then open that completed page. A normal page holds nine stickers.','Sưu tầm đủ hình trên một trang Sổ Hình Dán, rồi mở trang đã đầy. Một trang thường có chín hình.'],earn:['A golden frame, the theme’s celebration song and a decoration for your house. This page prize is claimed once.','Khung vàng, bài hát mừng theo chủ đề và đồ trang trí cho nhà. Quà của mỗi trang nhận một lần.'],find:['Pad → Album / Sticker Book. Tap missing stickers to hear where to find them.','Pad → Album / Sổ Hình Dán. Chạm hình còn thiếu để nghe nơi tìm.'],link:'#guide-prize-stickers'},
 {id:'passport',icons:['🛂','🧣','🤠'],title:['Five country stamps. Something to wear.','Năm dấu đất nước. Quà để đội, để quàng.'],complete:['Complete all five stamp tasks on one country’s Passport page.','Hoàn thành đủ năm việc đóng dấu trên trang Hộ chiếu của một nước.'],earn:['Vietnam: khăn rằn. Australia: Akubra. China: silk cap. India: Pagri. These are player wearables, separate from companion hats.','Việt Nam: khăn rằn. Úc: mũ Akubra. Trung Quốc: mũ lụa. Ấn Độ: khăn xếp Pagri. Bé dùng cho nhân vật, riêng với mũ bạn đồng hành.'],find:['Open Passport to see stamps, then Backpack to wear the prize.','Mở Hộ chiếu xem dấu, rồi Ba lô để dùng quà.'],link:'#guide-prize-passport'},
 {id:'family',icons:['💛','🪙','🌟'],title:['A real helping hand. A shared celebration.','Giúp một việc thật. Cả nhà cùng vui.'],complete:['Do a chosen family mission in real life, then ask a grown-up to hold the completion tick.','Làm thật một nhiệm vụ gia đình đã chọn, rồi nhờ người lớn giữ dấu tích xác nhận.'],earn:['10 in-game coins and a sticker when one is available. The reward follows the grown-up’s confirmation.','10 xu trong trò chơi và hình dán nếu có. Nhận quà sau khi người lớn xác nhận.'],find:['Pad → Adventures, with your grown-up beside you.','Pad → Phiêu lưu, có người lớn bên cạnh.'],link:'#guide-family'},
 {id:'hero',icons:['👑','🏆','🌈'],title:['Become a valley hero.','Trở thành anh hùng thung lũng.'],complete:['Finish all 17 goals of the main valley journey. This is separate from completing every game or every festival.','Hoàn thành cả 17 mục tiêu hành trình chính. Việc này riêng với chơi hết mọi trò hoặc mọi lễ hội.'],earn:['The hero celebration and a crown for your character, if you do not already own it.','Lễ mừng anh hùng và vương miện cho nhân vật nếu bé chưa có.'],find:['The crown is added to your owned hats.','Vương miện được thêm vào mũ nhân vật đã sở hữu.'],link:'#guide-valley'}
];
export function earnStrip({dual,icon},icons,label){return `<div class="earn-strip"><span class="earn-art" aria-hidden="true">${icons.map(k=>icon(k)||icon('⭐')).join('')}</span><div>${dual('strong','',['You can earn','Bé có thể nhận'])}${dual('span','',label)}</div></div>`}
export function rewardSections({dual,icon}){
 const D=(tag,pair,cls='')=>dual(tag,cls,pair),svg=k=>icon(k)||icon('⭐');
 const cards=rewardCards.map(c=>`<article class="reward-card" data-reward-id="${c.id}"><div class="reward-art" aria-hidden="true">${c.icons.map(svg).join('')}</div>${D('h3',c.title)}<div class="reward-condition">${D('strong',['COMPLETE THIS','HOÀN THÀNH VIỆC NÀY'])}${D('p',c.complete)}</div><div class="reward-prize">${D('strong',['EARN THIS','NHẬN QUÀ NÀY'])}${D('p',c.earn)}</div><details class="reward-where"><summary>${D('span',['Where do I see my prize?','Xem quà ở đâu?'])}</summary>${D('p',c.find)}</details><a class="quiet-link" href="${c.link}">${D('span',['See the steps →','Xem các bước →'])}</a></article>`).join('');
 const week=rewardData.weekPrizes.map((p,i)=>`<article class="prize-tile week-prize">${D('span',[`Prize ${i+1}`,`Quà ${i+1}`],'prize-number')}${svg(p.icon)}${D('h4',[p.en,p.vi])}${D('p',p.hat?['For your companion','Dành cho bạn đồng hành']:['A pet to look after','Thú cưng để chăm sóc'])}</article>`).join('');
 const passport=rewardData.countries.map(c=>`<article class="prize-tile passport-prize">${svg(c.hatIcon)}${D('h4',c.hatName)}${D('p',c.name)}</article>`).join('');
 const passportSteps=[['Visit the country’s place.','Ghé nơi của đất nước đó.'],['Collect two postcards from its landmarks.','Sưu tầm hai bưu thiếp từ danh thắng của nước đó.'],['Play one of its eligible games.','Chơi một trò phù hợp của nước đó.'],['Harvest one of its cultural crops.','Thu hoạch một cây trồng văn hóa của nước đó.'],['Learn about a traditional game from its information sign.','Tìm hiểu trò truyền thống qua biển thông tin.']];
 const badges=quests.hunts.map(f=>`<article class="festival-prize"><div class="festival-medallion">${svg(f.icon)}</div>${D('h4',[f.en,f.vi])}${D('p',[`Find five ${f.objectEn}.`,`Tìm đủ năm ${f.objectVi}.`])}<a href="#quest-hunt-${f.id}" class="quiet-link">${D('span',['Find this badge →','Tìm huy hiệu này →'])}</a></article>`).join('');
 const stickerIds=['hen','buffalo','bunny','koala','panda','dish_pho','mango','place_village','rainbow'];
 const stickers=stickerIds.map(id=>rewardData.stickers.find(s=>s.id===id)).filter(Boolean).map(s=>`<article class="prize-tile sticker-prize">${svg(s.icon)}${D('h4',[s.en,s.vi])}${D('p',s.hint)}</article>`).join('');
 const gameNames={rulefinder:['Find the Rule','Tìm Quy Luật'],gardenorder:['Garden Steps','Các Bước Làm Vườn'],steppingpath:['Flower Path','Đường Hoa'],patternpicnic:['Pattern Picnic','Dã Ngoại Quy Luật'],shapebuilders:['Shape Builders','Ghép Tranh Hình Khối'],remembergarden:['Remember the Garden','Nhớ Khu Vườn']};
 const skills=Object.entries(rewardData.skills).map(([id,s])=>`<article class="prize-tile skill-prize">${svg(s.key)}${D('h4',[s.en,s.vi])}${D('p',gameNames[id])}</article>`).join('');
 const more=[
 ['✨',['Solve a new shrine','Giải một đền mới'],['A Sparkle Orb + 20 coins + an available sticker for that shrine’s first completion.','Một Ngọc Lấp Lánh + 20 xu + hình dán nếu có khi giải đền đó lần đầu.']],
 ['📖',['Unlock a picture-book chapter','Mở một chương sách tranh'],['Certain main journey goals open storybook chapters with their own coin reward and an available sticker. These bonuses are separate from the lantern chapters.','Một số mục tiêu hành trình chính mở chương sách tranh, có thưởng xu riêng và hình dán nếu có. Thưởng này riêng với chương đèn lồng.']],
 ['🏗️',['Help finish the construction-yard story','Giúp hoàn thành truyện công trường'],['30 coins and access to replay the truck and excavator activities. Start by asking Bà Huệ at the Huệ Nghi shop.','30 xu và được chơi lại hoạt động xe ben, máy xúc. Bắt đầu bằng hỏi Bà Huệ ở tiệm Huệ Nghi.']],
 ['📝',['Finish a job-board task','Làm xong việc trên bảng việc làm'],['3 coins and an available sticker. Take the task, find or deliver the item, then finish at the marked goal.','3 xu và hình dán nếu có. Nhận việc, tìm hoặc giao đồ, rồi hoàn thành tại mục tiêu được đánh dấu.']],
 ['🎁',['Find the day’s surprise gift','Tìm món quà bất ngờ trong ngày'],['15 coins from the daily gift box near a landmark, when this family option is enabled.','15 xu từ hộp quà hằng ngày gần danh thắng khi gia đình bật lựa chọn này.']],
 ['⭐',['Finish a mini-game round','Hoàn thành một lượt trò chơi'],['The shared game celebration shows one to three stars; under-fives receive three. Coin rewards depend on the game and where it was started. Family Quiz uses this celebration too.','Phần mừng chung hiện một đến ba sao; bé dưới năm tuổi nhận ba. Thưởng xu tùy trò và nơi mở trò. Đố Vui Gia Đình cũng dùng phần mừng này.']]
 ].map(([pic,title,text])=>`<article class="more-reward">${svg(pic)}<div>${D('h4',title)}${D('p',text)}</div></article>`).join('');
 const collectibles=rewardData.collectibles.filter(c=>['f_rose','d_green','d_rainbow','s_koala','o_chime','o_teddy'].includes(c.id)).map(c=>`<article class="prize-tile collectible-prize"><span ${c.hue?`style="filter:hue-rotate(${c.hue}deg)"`:''}>${svg(c.icon)}</span>${D('h4',[c.en,c.vi])}</article>`).join('');
 const shelf=(id,title,text,body,open=false)=>`<details class="reward-shelf" data-reward-shelf="${id}" id="prize-${id}" ${open?'open':''}><summary>${D('span',title)}</summary>${D('p',text,'reward-shelf-intro')}${body}</details>`;
 const shelves=shelf('week',['Meet the seven-stamp chest prizes','Làm quen quà rương bảy dấu'],['The chest follows this list, skipping prizes you already own. The next prize depends on your collection; it is not a free choice from the pictures.','Rương theo danh sách này, bỏ qua quà bé đã có. Quà tiếp theo tùy bộ sưu tập, không phải bé tự chọn trong các hình.'],`<div class="prize-grid">${week}</div>`,true)
 +shelf('passport',['Country wearables: what earns each one?','Quà mặc, đội theo đất nước: làm gì để nhận?'],['Complete all five tasks on a country’s Passport page. Each full page awards the matching wearable below.','Làm đủ năm việc trên trang Hộ chiếu của một nước. Mỗi trang đầy tặng quà tương ứng dưới đây.'],`<ol class="passport-tasks">${passportSteps.map(p=>`<li>${D('span',p)}</li>`).join('')}</ol><div class="prize-grid four">${passport}</div>`)
 +shelf('badges',['See all 24 festival badges','Xem đủ 24 huy hiệu lễ hội'],['Each badge needs all five objects from that festival’s active hunt. Pictures use the game’s festival artwork; the Passport displays the earned festival mark.','Mỗi huy hiệu cần đủ năm món trong đợt săn đang diễn ra của lễ hội. Hình dùng tranh lễ hội của trò chơi; Hộ chiếu hiển thị dấu lễ hội đã nhận.'],`<div class="festival-prize-grid">${badges}</div>`)
 +shelf('stickers',['Stickers to discover around the valley','Hình dán để khám phá quanh thung lũng'],['A few examples from the Sticker Book. Each picture has its own clue; page prizes require the full page.','Một số ví dụ trong Sổ Hình Dán. Mỗi hình có manh mối riêng; quà trang cần dán đầy trang.'],`<div class="prize-grid">${stickers}</div>`)
 +shelf('skills',['Six special reasoning stickers','Sáu hình dán tư duy đặc biệt'],['For ages five and over: finish the matching reasoning game on Hard during local play. Each skill sticker is awarded once; it is not awarded by ordinary Easy rounds or online play.','Dành cho bé từ năm tuổi: hoàn thành trò tư duy tương ứng ở mức Khó khi chơi cục bộ. Mỗi hình nhận một lần; lượt Dễ thông thường hoặc chơi trực tuyến không tặng hình này.'],`<div class="prize-grid">${skills}</div>`)
 +shelf('mystery',['Surprises from mystery boxes','Bất ngờ từ hộp bí ẩn'],['When enabled, children aged 5–8 on Medium or Hard can open a daily box and earn up to one extra quest box a day. The contents vary; these are examples, not promised items. Duplicate collectibles turn into stars.','Khi được bật, bé 5–8 tuổi ở mức Vừa hoặc Khó có thể mở hộp ngày và kiếm thêm tối đa một hộp nhiệm vụ mỗi ngày. Quà thay đổi; đây là ví dụ, không phải món được hứa chắc. Món sưu tập trùng đổi thành sao.'],`<div class="prize-grid">${collectibles}</div>`)
 +shelf('more',['More ways to celebrate a discovery','Thêm cách mừng điều khám phá'],['Some rewards are one-time unlocks; others depend on the activity and family options. Check the current game’s reward message.','Có quà mở khóa một lần; có quà tùy hoạt động và lựa chọn gia đình. Xem thông báo thưởng trong trò chơi hiện tại.'],`<div class="more-rewards">${more}</div>`);
 const common=`${D('p',['Pictures show possible game rewards, not your child’s saved collection. Age, available stickers, family options and already-owned prizes can affect what arrives. Enjoy a little achievement, then take a break whenever you like.','Hình giới thiệu quà có thể nhận trong trò chơi, không phải bộ sưu tập đã lưu của bé. Tuổi, hình dán còn lại, lựa chọn gia đình và quà đã có có thể ảnh hưởng quà nhận được. Mừng một thành quả nhỏ rồi nghỉ khi muốn.'],'reward-note')}`;
 const home=`<section class="section rewards-section" id="rewards"><div class="section-lede"><div>${D('div',['LITTLE ACHIEVEMENTS. LOVELY THINGS TO COLLECT.','THÀNH QUẢ NHỎ. QUÀ XINH ĐỂ SƯU TẦM.'],'section-kicker')}${D('h2',['Look what you can earn!','Xem bé có thể nhận gì!'])}</div>${D('p',['Help a friend, finish a little adventure or explore a tradition. See what to complete and which treasure comes next.','Giúp một người bạn, làm xong phiêu lưu nhỏ hoặc khám phá truyền thống. Xem cần làm gì và quà nào đang chờ.'])}</div><div class="reward-card-grid">${cards}</div>${shelves}${common}</section>`;
 const guide=`<section class="guide-section rewards-section" id="guide-rewards">${D('h2',['Prizes & badges: complete this → earn this','Quà thưởng và huy hiệu: hoàn thành → nhận quà'])}${D('p',['Choose a reward to see its exact task. The pictures below explain possible rewards, not your current saved progress.','Chọn quà để xem việc cần làm. Hình dưới giải thích quà có thể nhận, không phải tiến trình đã lưu hiện tại.'],'guide-intro')}<div class="reward-card-grid">${cards}</div>${shelves.replaceAll('id="prize-','id="guide-prize-')}${common}</section>`;
 return {home,guide};
}
