const {chromium}=require('module').createRequire(require('path').resolve(__dirname,'../../tests/package.json'))('playwright');const assert=require('assert'),fs=require('fs');
const out=__dirname+'/evidence';
(async()=>{const browser=await chromium.launch({headless:true}),results=[];for(const [name,width,height]of [['phone',390,844],['tablet',820,1180],['desktop',1440,1000],['small-phone',320,740],['landscape',844,390]]){const p=await browser.newPage({viewport:{width,height}}),errors=[];p.on('pageerror',e=>errors.push(e.message));await p.goto('http://127.0.0.1:8765/docs/website-review-20261023/prototype.html',{waitUntil:'networkidle'});assert.equal(await p.locator('.quick-nav>a').count(),4);assert.equal(await p.locator('.menu-group').count(),4);for(const id of ['discover','learn','guides','family','games','folk','stories','parents','parent-controls','child-play-reports','parent-data','family-quiz','faq','help','rewards','festival-overview','quest-guide','festivals']){await p.evaluate(id=>location.hash='#'+id,id);await p.waitForFunction(id=>{const el=document.getElementById(id);return el&&!el.closest('[hidden]')},id);assert.equal(await p.locator('.home-page:not([hidden]),.topic-page:not([hidden]),.quest-page:not([hidden]),.festival-page:not([hidden])').count(),1);assert(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),name+' '+id);if(['learn','guides','family'].includes(id))await p.screenshot({path:out+'/navigation-'+name+'-'+id+'.png'});}await p.evaluate(()=>location.hash='#learn');await p.waitForFunction(()=>!document.querySelector('.learn-page').hidden);await p.locator('#language-button').click();assert.equal(await p.locator('.quick-nav a[aria-current=page]').textContent(),'Chơi và học');assert.deepEqual(errors,[]);results.push({name,fourCategories:true,allDestinations:true,noOverflow:true,englishVietnamese:true});await p.close()}await browser.close();fs.writeFileSync(out+'/navigation-checks.json',JSON.stringify(results,null,2));console.log(results)})().catch(e=>{console.error(e);process.exit(1)});
