// Generated illustrations are explicitly distinguished from the original game captures.
export function storybookFigure({data,dual,esc},file,title,caption){return `<figure class="storybook-photo"><button class="photo-open" data-view-image aria-label="${esc(title[0]+' / '+title[1])}"><img data-static-art loading="lazy" width="1672" height="941" src="${data('docs/website-review-20261023/assets/'+file,'image/png')}" data-alt-en="${esc(title[0])}" data-alt-vi="${esc(title[1])}" alt="${esc(title[0])}"></button><figcaption>${dual('h3','',title)}${dual('p','',caption)}</figcaption></figure>`}
