const {chromium}=require('module').createRequire(require('path').resolve(__dirname,'../../tests/package.json'))('playwright'),assert=require('assert'),fs=require('fs'),path=require('path');
const base=process.env.SV_PREVIEW_URL||'http://127.0.0.1:8765/docs/website-review-20261023/prototype.html',out=path.join(__dirname,'evidence');
async function menuGo(page,hash){await page.locator('[data-open-menu]').click();const link=page.locator('#menu-dialog a[href=\"'+hash+'\"]');const summary=link.locator('xpath=..').locator('summary');if(!await link.isVisible())await summary.click();await link.click()}
(async()=>{const browser=await chromium.launch({headless:true,args:['--disable-dev-shm-usage']}),results=[];
try{for(const[name,width,height]of [['phone',390,844],['tablet',820,1180],['desktop',1440,1000],['small-phone',320,740],['phone-landscape',844,390]]){const context=await browser.newContext({viewport:{width,height}}),page=await context.newPage(),errors=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(base,{waitUntil:'networkidle'});await page.evaluate(()=>document.fonts.ready);
await menuGo(page,'#rewards');await page.waitForFunction(()=>location.hash==='#rewards');
for(const[selector,count]of [['.reward-card',8],['.week-prize',9],['.passport-prize',4],['.festival-prize',24],['.skill-prize',6],['.sticker-prize',9],['.collectible-prize',6]])assert.equal(await page.locator('#rewards '+selector).count(),count,selector);
assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));await page.screenshot({path:`${out}/rewards-${name}-en.png`});
await page.locator('#rewards .reward-where>summary').first().click();await page.locator('#language-button').click();assert(await page.locator('#rewards .reward-where').first().evaluate(d=>d.open));await page.screenshot({path:`${out}/rewards-${name}-vi.png`});
await page.locator('#rewards [data-reward-shelf=week]').scrollIntoViewIfNeeded();await page.screenshot({path:`${out}/reward-chest-${name}-vi.png`});
await page.locator('#rewards [data-reward-shelf=badges]>summary').click();await page.locator('#rewards [data-reward-shelf=badges]').scrollIntoViewIfNeeded();await page.screenshot({path:`${out}/reward-badges-${name}-vi.png`});assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
await page.locator('#rewards a[href="#quest-hunt-midautumn"]').click();await page.waitForFunction(()=>!document.querySelector('.quest-page').hidden);assert(await page.locator('#quest-hunt-midautumn').evaluate(d=>d.open));assert.equal(await page.locator('#quest-hunt-midautumn .earn-strip svg').count(),2);
await page.locator('.guide-nav a[href="#guide-daily"]').click();await page.locator('#quest-daily-eggs>summary').click();assert.equal(await page.locator('#quest-daily-eggs .earn-strip svg').count(),3);assert(/Gà mái/.test(await page.locator('#quest-daily-eggs .earn-strip').innerText()));
await page.locator('#quest-daily-eggs').scrollIntoViewIfNeeded();await page.screenshot({path:`${out}/quest-reward-${name}-vi.png`});
await page.locator('#quest-search').fill('DOAN NGO');assert(!await page.locator('#quest-hunt-doanngo').evaluate(d=>d.hidden));await page.locator('#quest-search').fill('noSuchRewardZZZ');await page.locator('.guide-nav a[href="#guide-rewards"]').click();await page.locator('#guide-rewards [data-reward-shelf=badges]>summary').click();await page.locator('#guide-rewards a[href="#quest-hunt-easter"]').click();await page.waitForFunction(()=>location.hash==='#quest-hunt-easter'&&document.querySelector('#quest-search').value==='');assert.equal(await page.locator('#quest-search').inputValue(),'');assert(await page.locator('#quest-hunt-easter').evaluate(d=>d.open));
await menuGo(page,'#rewards');await page.waitForFunction(()=>location.hash==='#rewards');await page.locator('#rewards [data-reward-id=passport] a').click();await page.waitForFunction(()=>location.hash==='#guide-prize-passport'&&document.querySelector('#guide-prize-passport').open);assert.equal(await page.locator('#guide-prize-passport .passport-tasks li').count(),5);assert.equal(await page.evaluate(()=>[...document.querySelectorAll('[data-en]')].filter(n=>!n.dataset.en||!n.dataset.vi).length),0);assert.deepEqual(errors,[]);results.push({name,width,height,mainCards:8,weekPrizes:9,passportPrizes:4,festivalBadges:24,skillStickers:6,stickerExamples:9,mysteryExamples:6,bilingual:true,expandedStatePreserved:true,badgeLinksOpenExactQuest:true,searchRecovery:true,dailySpecificSticker:true,noOverflow:true,errors});await context.close();}
}finally{await browser.close()}
fs.writeFileSync(out+'/reward-checks.json',JSON.stringify(results,null,2));console.log('Reward showcase checks passed on '+results.length+' layouts');})().catch(e=>{console.error(e);process.exit(1)});
