const path=require('path'),fs=require('fs'),assert=require('assert');
const {chromium}=require('module').createRequire(path.resolve(__dirname,'../../tests/package.json'))('playwright');
const base=process.env.SV_PREVIEW_URL||'http://127.0.0.1:8765/docs/website-review-20261023/prototype.html',out=path.join(__dirname,'evidence');
(async()=>{const browser=await chromium.launch({headless:true}),results=[];try{for(const[name,width,height]of [['phone',390,844],['tablet',820,1180],['desktop',1440,1000],['small-phone',320,740],['landscape',844,390]]){const context=await browser.newContext({viewport:{width,height}}),page=await context.newPage(),errors=[],privateCalls=[];page.on('pageerror',e=>errors.push(e.message));page.on('request',r=>{if(/\/api\//.test(r.url()))privateCalls.push(r.url())});await page.addInitScript(()=>{window.__storageReads=[];const get=Storage.prototype.getItem;Storage.prototype.getItem=function(key){window.__storageReads.push(key);return get.call(this,key)}});await page.goto(base,{waitUntil:'networkidle'});await page.locator('[data-open-menu]').click();await page.locator('[data-menu-group=family]>summary').click();await page.locator('#menu-dialog a[href="#parent-controls"]').click();await page.waitForFunction(()=>!document.querySelector('.family-page').hidden&&location.hash==='#parent-controls');assert.equal(await page.locator('.quick-nav>a').count(),4);assert.equal(await page.locator('.control-card').count(),9);assert.equal(await page.locator('.child-reports .report-facts article').count(),6);assert.equal(await page.locator('.parent-screen').count(),2);assert.equal(await page.locator('.example-day').count(),7);assert.equal(await page.locator('[data-example-minutes]').getAttribute('data-example-minutes'),'93');assert.equal(await page.locator('[data-example-rounds]').getAttribute('data-example-rounds'),'15');assert(/MADE-UP DATA/.test(await page.locator('.example-label').innerText()));await page.locator('[data-demo-day=wed]').click();assert(/Wednesday: 0 minutes/.test(await page.locator('.example-day-detail').innerText()));await page.locator('[data-demo-day=fri]').click();assert(/Friday: 22 minutes/.test(await page.locator('.example-day-detail').innerText()));await page.locator('#example-play-report').scrollIntoViewIfNeeded();await page.screenshot({path:path.join(out,`example-report-${name}-en.png`)});assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
await page.locator('.control-card>summary').nth(2).click();assert(/15, 30, 45 or 60/.test(await page.locator('.control-card').nth(2).innerText()));await page.screenshot({path:path.join(out,`parent-controls-${name}-en.png`)});
await page.locator('#language-button').click();assert(await page.locator('.control-card').nth(2).evaluate(d=>d.open));assert(/GIẢ ĐỊNH/.test(await page.locator('.example-label').innerText()));assert(/Thứ Sáu: 22 phút/.test(await page.locator('.example-day-detail').innerText()));assert.equal(await page.locator('[data-demo-day=fri]').getAttribute('aria-pressed'),'true');await page.locator('#example-play-report').scrollIntoViewIfNeeded();await page.screenshot({path:path.join(out,`example-report-${name}-vi.png`)});assert(/giờ nhắc nghỉ/.test(await page.locator('.control-card>summary').nth(2).innerText()));await page.screenshot({path:path.join(out,`parent-controls-${name}-vi.png`)});
await page.locator('#parent-controls .topic-links a[href="#child-play-reports"]').click();await page.waitForFunction(()=>location.hash==='#child-play-reports');assert.equal(await page.locator('.report-steps li').count(),3);await page.locator('.parent-screen .photo-open').last().click();assert(await page.locator('#image-dialog').evaluate(d=>d.open));assert(await page.locator('#large-image').evaluate(i=>i.complete&&i.naturalWidth>0));assert(/Báo cáo chơi/.test(await page.locator('#image-caption').innerText()));await page.keyboard.press('Escape');assert(await page.locator('.parent-screen .photo-open').last().evaluate(b=>b===document.activeElement));await page.locator('#child-play-reports').scrollIntoViewIfNeeded();await page.screenshot({path:path.join(out,`parent-reports-${name}-vi.png`)});assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
await page.evaluate(()=>location.hash='#parent-data');await page.waitForFunction(()=>location.hash==='#parent-data');assert(/không tự gộp/.test(await page.locator('#parent-data').innerText()));assert(/tên gọi và nhóm tuổi/.test(await page.locator('#parent-data').innerText()));assert.equal(await page.evaluate(()=>localStorage.length),0);assert.deepEqual(await page.evaluate(()=>window.__storageReads),[]);assert.deepEqual(privateCalls,[]);
await page.locator('[data-mode-button=game]').click();await page.locator('#settings-button').click();assert(!await page.locator('.welcome-website').isVisible());await page.locator('.website-entry').click();await page.locator('[data-open-menu]').click();await page.locator('#menu-dialog a[href="#child-play-reports"]').click();await page.waitForFunction(()=>location.hash==='#child-play-reports');await page.locator('#close-site').click();assert(await page.locator('#settings-panel').evaluate(d=>d.classList.contains('open')));assert(await page.locator('.website-entry').evaluate(b=>b===document.activeElement));assert.deepEqual(errors,[]);results.push({name,width,height,fourMainDestinations:true,parentControls:9,reportExplanations:6,bilingual:true,detailsRetainedAcrossLanguage:true,reportSteps:3,twoRealUiPictures:true,illustrativeGraphClearlyLabelled:true,sampleTotalsAndInteractiveDays:true,exampleSelectionRetainedAcrossLanguage:true,lightboxAndFocus:true,noOverflow:true,noPrivateDataReadsOrApiCalls:true,settingsOnlyDuringPlay:true,floatingClosePreservesSettings:true,errors});await context.close()}}finally{await browser.close()}fs.writeFileSync(path.join(out,'parent-controls-checks.json'),JSON.stringify(results,null,2));console.log('Parent settings/report checks passed on '+results.length+' layouts')})().catch(e=>{console.error(e);process.exit(1)});
