  "lines": [
    {
      "id": "048f1f30-37535101",
      "lang": "vi",
      "text": "Ông thợ nào khỏe",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "0d1b07a5-53370dbe",
      "lang": "vi",
      "text": "Cổ điển · một xúc xắc",
      "area": "games",
      "part": false,
      "source": [
        "js/games/cacuangua.js"
      ]
    },
    {
      "id": "187f8dbf1f6b937c",
      "lang": "vi",
      "text": "Trong mèo đuổi chuột, các bạn nắm tay thành vòng tròn. Chuột luồn qua tay giơ cao, mèo đuổi theo đường chuột đã chạy. Ở đây cổng và cuộc đuổi bắt chuyển từng bước nhẹ nhàng.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "18fdf4bf2a9acc32",
      "lang": "vi",
      "text": "Quả còn bay qua vòng rồi!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "1915d97954f7f751",
      "lang": "vi",
      "text": "Cờ Cá Ngựa",
      "area": "games",
      "part": false,
      "source": [
        "js/games/cacuangua.js"
      ]
    },
    {
      "id": "1b9b622526a2c94c",
      "lang": "vi",
      "text": "Cùng nhau giỏi quá!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/fruitparade.js"
      ]
    },
    {
      "id": "1e3c2ab627b36b45",
      "lang": "vi",
      "text": "Nhiệm Vụ Vườn Quả Lấp Lánh",
      "area": "games",
      "part": false,
      "source": [
        "js/games/sparkleorchard.js"
      ]
    },
    {
      "id": "206a7a83-4833bc85",
      "lang": "vi",
      "text": "Đưa các chú ngựa về chuồng nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/cacuangua.js"
      ]
    },
    {
      "id": "206f71c85c63ff7b",
      "lang": "vi",
      "text": "Ba!",
      "area": "hanoi",
      "part": false,
      "source": [
        "js/content/chapter2text.js"
      ]
    },
    {
      "id": "24a09649-2533e125",
      "lang": "vi",
      "text": "Giỏi lắm! Xem mình tìm được gì nào!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/fruitparade.js"
      ]
    },
    {
      "id": "258378c8063a5e71",
      "lang": "vi",
      "text": "Giảm lực",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "28fbc4954daa3fe3",
      "lang": "vi",
      "text": "Ngắm phải",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "2964e89112c4e669",
      "lang": "vi",
      "text": "Ván hay quá!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/oanquan-online.js"
      ]
    },
    {
      "id": "2b586e58-399d9bea",
      "lang": "vi",
      "text": "Tìm tranh. Dừng ở giữa nhé.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/fruitparade.js"
      ]
    },
    {
      "id": "2c3f0bff-4e52a134",
      "lang": "vi",
      "text": "Ngựa về chuồng rồi!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/cacuangua.js"
      ]
    },
    {
      "id": "2d8eeb15-73a87d3a",
      "lang": "vi",
      "text": "Về ăn cơm vua",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "2f061dda-331b13db",
      "lang": "vi",
      "text": "Bảng Trái Cây Lấp Lánh",
      "area": "games",
      "part": false,
      "source": [
        "js/games/sparklefruitbar.js"
      ]
    },
    {
      "id": "334569db3dda1721",
      "lang": "vi",
      "text": "Đội hai thắng rồi!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/tug-online.js"
      ]
    },
    {
      "id": "3f99d80c27966995",
      "lang": "vi",
      "text": "Cờ về đội mình rồi!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "3fbf022c-1bfa6fb7",
      "lang": "vi",
      "text": "Hoàn thành nhiệm vụ vườn quả!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/sparkleorchard.js"
      ]
    },
    {
      "id": "41c6fd9e26a22ebf",
      "lang": "vi",
      "text": "Con hiểu gia đình mình quá!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/familyquiz.js"
      ]
    },
    {
      "id": "44d90206-2cbde64a",
      "lang": "vi",
      "text": "Tăng lực",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "46c557ad-329f4df2",
      "lang": "vi",
      "text": "Ông thợ nào thua",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "4852321f-1918e6fe",
      "lang": "vi",
      "text": "Trong cướp cờ, hai đội đánh số đứng hai bên lá cờ giữa sân. Hai bạn cùng số chạy khi được gọi, rồi tìm cách đem cờ về vạch đội mình. Bản màn hình này cho các bạn tập nhẹ nhàng.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "4ff39bc0-380f8516",
      "lang": "vi",
      "text": "Bảng trái cây",
      "area": "festivals",
      "part": false,
      "source": [
        "js/content/releases.js"
      ]
    },
    {
      "id": "5b0e3da35ae5eec6",
      "lang": "vi",
      "text": "Diễu hành trái cây lấp lánh",
      "area": "games",
      "part": false,
      "source": [
        "js/games/fruitparade.js"
      ]
    },
    {
      "id": "625449d74c93cbae",
      "lang": "vi",
      "text": "Đếm các bước và leo thang. Cùng đưa mọi quân về đích nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/snakes.js"
      ]
    },
    {
      "id": "62afe8e9-5b49df2",
      "lang": "vi",
      "text": "Con ngắm trúng rồi!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "64908fa818dffbc8",
      "lang": "vi",
      "text": "Hai bạn chồng chân và tay lên nhau. Giúp bạn cùng nhảy qua nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/trongnu.js"
      ]
    },
    {
      "id": "657e64de78bd5250",
      "lang": "vi",
      "text": "Chèo trái",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "6e4deb12-4f3cc1fd",
      "lang": "vi",
      "text": "Trượt viên đáo vào các đồng xu đồ chơi. Chỉnh hướng và lực nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "70c589e6-60de9a67",
      "lang": "vi",
      "text": "Thuyền hội có cả đội chèo. Chèo trái rồi phải, cùng theo nhịp trống nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "766d7ef2-4816612d",
      "lang": "vi",
      "text": "Đường ngắn nhẹ nhàng",
      "area": "games",
      "part": false,
      "source": [
        "js/games/cacuangua.js"
      ]
    },
    {
      "id": "771d8597-5ca63d63",
      "lang": "vi",
      "text": "Cùng đọc đồng dao thật vui!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "8021a60c-206da1d6",
      "lang": "vi",
      "text": "Bốn!",
      "area": "hanoi",
      "part": false,
      "source": [
        "js/content/chapter2text.js"
      ]
    },
    {
      "id": "81b5ec7f-5ec4b071",
      "lang": "vi",
      "text": "Đội một thắng rồi!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/tug-online.js"
      ]
    },
    {
      "id": "837dda3931014857",
      "lang": "vi",
      "text": "Ngắm trái",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "8482a48a1525e6f6",
      "lang": "vi",
      "text": "Ai cùng chơi nào?",
      "area": "games",
      "part": false,
      "source": [
        "js/games/fruitparade.js"
      ]
    },
    {
      "id": "8a3d5d192bc31468",
      "lang": "vi",
      "text": "Chia hai đội, cùng kéo dây. Bấm Kéo để giúp đội mình đưa cờ về vạch nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/tug-online.js"
      ]
    },
    {
      "id": "8c881541-292ebe16",
      "lang": "vi",
      "text": "Trò này dành cho người thử được mời.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/sparkleorchard.js"
      ]
    },
    {
      "id": "8f54cd8c-51fd3984",
      "lang": "vi",
      "text": "Ném còn có trong lễ hội của người Tày, Thái, Mường và các cộng đồng khác. Quả còn bằng vải nhiều màu, có tua, bay qua vòng trên cột cao. Đây là bản chơi nhẹ nhàng trên màn hình.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "920ca587280f751b",
      "lang": "vi",
      "text": "Ném quả còn bằng vải qua vòng trên cao. Chỉnh hướng rồi ném nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "9489dcb10790ed06",
      "lang": "vi",
      "text": "Tìm tranh trong nhiệm vụ. Dừng đèn nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/sparkleorchard.js"
      ]
    },
    {
      "id": "99b3b2d6010a01be",
      "lang": "vi",
      "text": "Chèo phải",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "9bc729794c4784ce",
      "lang": "vi",
      "text": "Bạn máy suy nghĩ",
      "area": "games",
      "part": false,
      "source": [
        "js/games/cacuangua.js"
      ]
    },
    {
      "id": "9c91c3de-a4aff7e",
      "lang": "vi",
      "text": "Ai cùng khám phá vườn quả?",
      "area": "games",
      "part": false,
      "source": [
        "js/games/sparkleorchard.js"
      ]
    },
    {
      "id": "a0079f84369e8c4f",
      "lang": "vi",
      "text": "Nắm tay bạn. Cùng kéo và đẩy theo nhịp đồng dao nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "a26e675c-3e4bbfb9",
      "lang": "vi",
      "text": "Kéo cưa lừa xẻ",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "a273cca9-3182001a",
      "lang": "vi",
      "text": "Hai!",
      "area": "hanoi",
      "part": false,
      "source": [
        "js/content/chapter2text.js"
      ]
    },
    {
      "id": "a7ad3ed7-203dc555",
      "lang": "vi",
      "text": "Chuột qua được vòng tròn rồi!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "aa847a200d5012f7",
      "lang": "vi",
      "text": "Số một! Lấy cờ rồi mang về đội nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "ac8faf4b-71272d62",
      "lang": "vi",
      "text": "Hai đội có số giống nhau. Đầu tiên, số hai! Lấy cờ giữa sân rồi mang về đội nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "b01b8c2b-4f3dec70",
      "lang": "vi",
      "text": "Đua thuyền có trong nhiều lễ hội Việt Nam. Cả đội cùng chèo theo nhịp trống. Ở đây các đội trong làng đua theo nhịp nhẹ nhàng, không giới hạn giờ cho bé nhỏ.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "b2774ede-604ef542",
      "lang": "vi",
      "text": "Các bạn nắm tay thành vòng tròn. Dẫn chuột qua cổng đang mở. Mèo đuổi theo đúng lối ấy nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "b78f6a71-19285248",
      "lang": "vi",
      "text": "Mang cờ về đội",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "c237f213-78a3a99b",
      "lang": "vi",
      "text": "Kéo cưa lừa xẻ là trò nắm tay đu đưa. Hai bạn ngồi đối diện, kéo đẩy qua lại theo từng tiếng trong đồng dao. Không có cưa thật.",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "c5ca86d90-3997c8",
      "lang": "vi",
      "text": "Số ba! Lấy cờ rồi mang về đội nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
      "id": "cca8abd8-3fdb5f45",
      "lang": "vi",
      "text": "Đội mình khỏe quá!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/tug-online.js"
      ]
    },
    {
      "id": "dd02167e-556172cf",
      "lang": "vi",
      "text": "Ai cũng cùng giúp nhé! Mỗi bạn kéo ít nhất hai lần. Kéo đủ hai mươi bốn lần thì cùng ăn mừng!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/tug-online.js"
      ]
    },
    {
      "id": "ddfde0b471af1ad6",
      "lang": "vi",
      "text": "Số hai! Lấy cờ rồi mang về đội nhé!",
      "area": "games",
      "part": false,
      "source": [
        "js/games/folk-court.js"
      ]
    },
    {
