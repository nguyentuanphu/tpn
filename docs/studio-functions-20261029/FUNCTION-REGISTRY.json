      "capability": "not-implemented",
      "collect": [],
      "process": [],
      "show": []
    },
    {
      "id": "experiments",
      "capability": "not-implemented",
      "collect": [],
      "process": [],
      "show": []
    },
    {
      "id": "providerSync",
      "capability": "not-implemented",
      "collect": [],
      "process": [],
      "show": []
    },
    {
      "id": "saves-and-gameplay",
      "capability": "protected",
      "collect": [],
      "process": [],
      "show": []
    }
  ]
}
